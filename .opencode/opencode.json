{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/ai/CONTEXT_INDEX.md"
  ],
  "permission": {
    "*": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",

      "pwd*": "allow",
      "ls*": "allow",
      "find*": "allow",
      "grep*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "sed*": "allow",
      "wc*": "allow",
      "which*": "allow",
      "echo*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",

      "pytest*": "ask",
      "python3 -m pytest*": "ask",
      "ruff*": "ask",
      "mypy*": "ask",
      "npm test*": "ask",
      "npm run lint*": "ask",
      "npm run typecheck*": "ask",
      "npm run build*": "ask",
      "npm run dev*": "ask",
      "docker compose config*": "ask",
      "docker compose up*": "ask",
      "docker compose down*": "ask",
      "docker compose build*": "ask",
      "bash scripts/verify.sh*": "ask",
      "bash scripts/ai_context.sh*": "ask",
      "repomix*": "ask",

      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "rm -rf*": "deny",
      "sudo*": "deny",
      "chmod -R 777*": "deny",
      "chmod 777*": "deny",
      "curl * | bash*": "deny",
      "wget * | bash*": "deny",
      "eval*": "deny",
      "source*": "deny",
      "docker system prune*": "deny",
      "docker rm*": "deny",
      "docker rmi*": "deny",
      "apt*": "deny",
      "apt-get*": "deny",
      "chown*": "deny",
      "kill -9*": "deny"
    }
  }
}
