# ============================================================
# IMAGINA — L1 .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/

# ---- Testing & Linting ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/
*.tsbuildinfo

# ---- IDE & Editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Environment & Secrets ----
.env
.env.local
.env.production
.env.*
secrets/
*.pem
*.key
*.p12
*.pfx
credentials.*

# ---- Runtime Data (local sessions, exports, cache, benchmarks) ----
data/
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm
*.pt
*.pth
*.ckpt
*.parquet
*.csv

# ---- External EEG Data (never commit) ----
data/OpenMIIR-RawEEG/
backend/data/external/
backend/data/cache/
backend/data/processed/
backend/data/backups/
backend/data/exports/*.csv
backend/data/exports/*.npy
backend/data/exports/*.npz

# ---- AI Context (snapshots, repomix) ----
docs/ai/repo_snapshot.md
docs/ai/snapshots/
frontend_git_backup_*.tar.gz
frontend/.git.disabled/

# ---- Nested repos / backups ----
frontend/.git/
backend/.git/
data/backups/
*.tar.gz

# ---- Docker build artifacts ----
*.log

# ---- Generated API docs (optional) ----
docs/api/generated/

# ---- Volatile acquisition state (never commit) ----
results/.acquisition_checkpoint.json
results/.download_lock
