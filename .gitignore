# ============================================================
# IMAGINA Monorepo — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.turbo/

# ---- Testing & Linting ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/
*.tsbuildinfo

# ---- IDE & Editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Environment & Secrets ----
.env
.env.local
.env.production
.env.*
secrets/
*.pem
*.key
*.p12
*.pfx
credentials.*

# ---- Data (local SQLite, sessions, exports) ----
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm
data/sessions/*.json
data/sessions/*.db
data/exports/*.html
data/exports/*.json

# ---- ML / Data (model checkpoints, parquet, CSV) ----
*.pt
*.pth
*.ckpt
*.parquet
*.csv

# ---- AI Context (Repomix output, snapshots) ----
docs/ai/repo_snapshot.md
docs/ai/snapshots/
frontend_git_backup_*.tar.gz
frontend/.git.disabled/

# ---- Nested repos (if any remain after cleanup) ----
frontend/.git/
backend/.git/

# Git backups created during monorepo cleanup
data/backups/
*.tar.gz
